# Si4463 telemetry decoder, as a systemd service.
#
# This is a template. install.sh fills in __USER__ and __DIR__ and writes
# si4463-decoder.service next to it, because the account name and the install
# path are not knowable in advance - Bookworm no longer creates a user called
# "pi", so hard-coding one would produce a unit that silently fails to start.
#
#     sudo cp si4463-decoder.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now si4463-decoder
#     journalctl -u si4463-decoder -f

[Unit]
Description=Si4463 telemetry decoder (RTL-SDR)
Documentation=file://__DIR__/README.md
After=multi-user.target

[Service]
Type=simple
User=__USER__
# plugdev is what the udev rule grants the dongle to. Without it the service
# runs as a user who cannot open the device, which looks identical to a dongle
# that is not plugged in.
Group=plugdev
WorkingDirectory=__DIR__

# Quieter than the interactive defaults. At 30 s a heartbeat is useful on a
# terminal and is 2880 journal lines a day on a Pi; at 300 s it still proves
# the decoder is alive without filling the SD card. Packets are logged in full
# either way, both to the journal and to logs/packets_*.csv.
ExecStart=/usr/bin/python3 __DIR__/si4463_rt.py --heartbeat 300 --status 300

Restart=always
RestartSec=5
# Give up announcing failure only after sustained flapping, so a dongle pulled
# out and pushed back in recovers on its own rather than needing a reset.
StartLimitIntervalSec=300
StartLimitBurst=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=si4463

# A dropped USB buffer is a lost packet, so the decoder is given a small edge
# over background work. Not real-time scheduling: this is a 15% duty on one
# core of four, and starving the rest of the system would be a worse trade.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

# It reads one USB device and writes one log directory; nothing else.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DIR__/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
